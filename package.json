{
  "name": "dsh-lot-map",
  "version": "1.0.0",
  "description": "Live visual work map beside the chat for DeepSeek Harness: tool calls, model steps, memory, files, shell, network, browser, agents, skills and hooks light up in real time.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lot-map",
    "visualization",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DestinySail/dsh-lot-map.git"
  },
  "homepage": "https://github.com/DestinySail/dsh-lot-map",
  "bugs": {
    "url": "https://github.com/DestinySail/dsh-lot-map/issues"
  },
  "author": "DestinySail",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
